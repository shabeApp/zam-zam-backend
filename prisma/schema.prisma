generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  username        String    @unique
  email           String    @unique
  password        String
  phoneNumber     String?
  countryCode     String?
  gender          String?
  dateOfBirth     String?
  role            Role      @default(USER)
  isEmailVerified Boolean   @default(false)
  isBlocked       Boolean   @default(false)
  lockedUntil     DateTime? // Account lockout
  deletedAt       DateTime? // Soft delete (skip in queries)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens  RefreshToken[]  @relation("UserRefreshTokens")
  emailTokens    EmailToken[]    @relation("UserEmailTokens")
  productReviews ProductReview[] @relation("UserProductReviews")
  orders         Order[]         @relation("UserOrders")
  cartItems      CartItem[]      @relation("UserCartItems")
  addresses      Address[]       @relation("UserAddresses")
  couponIds      String[]        @db.ObjectId
  couponsUsed    Coupon[]        @relation("UserCoupons", fields: [couponIds], references: [id])

  @@index([role])
  @@index([lockedUntil])
  @@index([deletedAt])
  @@index([isEmailVerified])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash  String
  revoked    Boolean  @default(false)
  replacedBy String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum TokenPurpose {
  VERIFY_EMAIL
  FORGOT_PASSWORD
  OTP
}

model EmailToken {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String
  purpose   TokenPurpose // VERIFY_EMAIL | FORGOT_PASSWORD | OTP
  used      Boolean      @default(false)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  userId String @db.ObjectId
  user   User   @relation("UserEmailTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

type Image {
  url       String?
  publicUrl String?
}

type SubProduct {
  sku    String
  type   String   // size , color , material , other....
  qty    Int      @default(0)
  price  Int
  images String[]
  size   String[]
  sold   Int      @default(0)
}


model Product {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  slug              String   @unique
  description       String
  longDescription   String?
  sku               String   @unique
  generalImages     String[]
  descriptionImages String[]

  featured           Boolean @default(false)
  productIsAvailable Boolean @default(true)

  discount Int @default(0)
  sold     Int @default(0)
  disableProduct Boolean? @default(false)
  disableProductDate DateTime?

  rating     Float @default(0)
  numReviews Int   @default(0)

  // Custom types
  subProducts SubProduct[]
  ingredients Json?

  // Relations
  // vendorId String? @db.ObjectId
  // vendor   Vendor @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId String   @db.ObjectId
  category   Category @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: Cascade)

  productReviews ProductReview[] @relation("UserProductReviews")
  cartItems      CartItem[]      @relation("UserCartItems")
  orderItems     OrderItem[]     @relation("ProductOrderItems")
  coupons        Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@index([vendorId])
  // @@index([disableProduct])
  @@index([createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([featured])
  @@index([productIsAvailable])
  @@index([sold(sort: Desc)])
  @@index([rating(sort: Desc)])
  @@index([categoryId, disableProduct, productIsAvailable])
  @@index([featured, disableProduct])
  // @@index([vendorId, disableProduct])
  @@index([categoryId, featured, disableProduct])
  @@map("products")
}

