model Category {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  slug     String
  image    String  
  featured Boolean @default(false)

  // Self-referential relationship for nested categories
  parentCategoryId String?    @db.ObjectId
  parentCategory   Category?  @relation("SubCategories", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories    Category[] @relation("SubCategories")

  products  Product[] @relation("CategoryProducts")
  coupons   Coupon[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentCategoryId])
  @@map("categories")
}



model ProductReview {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  rating     Float   @default(0)
  comment    String
  isApproved Boolean @default(false)

  productId String  @db.ObjectId
  product   Product @relation("UserProductReviews", fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userId String @db.ObjectId
  user   User   @relation("UserProductReviews", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("productReviews")
}

model CartItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  quantity Int @default(1)
  price    Int // snapshot price

  selectedSize String?

  isSelected Boolean @default(true)

  productId String  @db.ObjectId
  product   Product @relation("UserCartItems", fields: [productId], references: [id], onDelete: NoAction)

  userId String @db.ObjectId
  user   User   @relation("UserCartItems", fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId, selectedSize])
  @@index([userId])
  @@index([deletedAt])
}

// Use enums:
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  COD
}

type ShippingAddress {
  name       String
  phone      String
  address    String
  city       String
  state      String
  postalCode String
  country    String
}


type PhonePePaymentResponse {
  success Boolean
  code String
  message String
  data PaymentData
}

// Core Payment Data Type
type PaymentData {
  merchantId String
  merchantTransactionId String
  transactionId String
  amount Int
  state String
  responseCode String
  paymentInstrument PaymentInstrument
}

// Payment Instrument (UPI, Card, Net Banking, Wallet, etc.)
type PaymentInstrument {
  type String
  utr String?
  cardType String?
  bankTransactionId String?
  arn String?
  bankId String?
}

model Order {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber    String        @unique // User-friendly order ID
  totalAmount    Int
  taxAmount      Int           @default(0)
  shippingAmount Int           @default(0)
  discountAmount Int           @default(0)

  // Shipping info
  shippingAddress ShippingAddress

  // Payment info
  paymentData PaymentData
  paymentMethod PaymentMethod
  transactionId String?
  status PaymentStatus
  orderStatus OrderStatus

  userId String @db.ObjectId
  user   User   @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  orderItems OrderItem[] @relation("OrderOrderItems")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([orderStatus])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  price    Int // Price at time of purchase
  size     String? // Selected size if applicable

  productId String  @db.ObjectId
  product   Product @relation("ProductOrderItems", fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  orderId String @db.ObjectId
  order   Order  @relation("OrderOrderItems", fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("orderItems")
}

enum AddressType {
  MY_ADDRESS
  GIFT_ADDRESS
}

model Address {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name  String
  phone String
  email String?

  street     String
  city       String
  state      String
  postalCode String
  country    String

  label     String? // Home, Office
  isDefault Boolean @default(false)

  addressType AddressType

  // 🎁 Gift fields
  friendName      String?
  friendPhone     String?
  giftDescription String?

  // 👤 User relation
  userId String @db.ObjectId
  user   User   @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)

  // 🧹 Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}

enum BannerType {
  HOME
  CATEGORY
  PRODUCT
}

type BannerLink {
  type BannerType
  id   String?    @db.ObjectId
  url  String?
}

model Banner {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String
  description String
  image       String?
  link        String?
  type        BannerType @default(HOME)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("banners")
  @@unique([slug])
}

model TopBarNotification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notificationBars")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
  USER
}

model Coupon {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  code        String  @unique
  description String?

  // 🔥 Discount Type
  discountType  DiscountType
  discountValue Int

  // 💰 Limits
  maxDiscountAmount Int? // Cap for % discount
  minPurchaseAmount Int? // Minimum cart value

  // ⏳ Validity
  validFrom  DateTime
  validUntil DateTime

  // 🔢 Usage Control
  usageLimit Int? // Total usage
  usedCount  Int  @default(0)

  perUserLimit Int? // Per user usage

  // 🔒 Status
  isActive Boolean @default(true)

  // 🎯 Scope (Optional)
  applicableTo CouponScope @default(ALL)

  // 👤 User restriction (optional)
  userIds String[] @db.ObjectId
  users   User[]   @relation("UserCoupons", fields: [userIds], references: [id])

  // 📦 Optional: Apply to category/product
  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validFrom, validUntil])
  @@index([isActive])
  @@map("coupons")
}
